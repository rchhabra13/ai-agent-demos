# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── LLM Settings ───────────────────────────────────────────────────────────────
# Model to use for reasoning (claude-opus-4-6 recommended for accuracy)
LLM_MODEL=claude-opus-4-6
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.1

# ── ClinicalTrials.gov ─────────────────────────────────────────────────────────
# Free API — no key required, but set a polite User-Agent
CTGOV_BASE_URL=https://clinicaltrials.gov/api/v2
CTGOV_USER_AGENT=ClinicalTrialMatchmaker/0.1.0 (rishi.chhabra@outlook.com)
CTGOV_MAX_RESULTS=20
CTGOV_TIMEOUT_SECONDS=30

# ── FHIR ───────────────────────────────────────────────────────────────────────
# Default FHIR server for development (Synthea / HAPI public test server)
FHIR_BASE_URL=https://hapi.fhir.org/baseR4
FHIR_TIMEOUT_SECONDS=30

# ── Server ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=development
# Set to "production" to enable stricter validation and disable debug output
